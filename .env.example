# Copy to apps/api/.env. Login pages work before credentials are configured.
PORT=4000
HOST=127.0.0.1
# User workspaces remain in JSON files, separate from MongoDB authentication.
WORKSPACE_DATA_DIR=../../.data/workspaces
# MongoDB authentication database. Add your connection URL here later.
MONGODB_URI=
MONGODB_DB=analytiq
# Atlas / replica sets support transactions. Set false for standalone MongoDB.
MONGODB_TRANSACTIONS=true
# Generate a random secret of at least 32 characters. Keep it server-side.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth credentials (Web application). Callback URI:
# http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Reserved for the future Postgres repository. Not used by the JSON adapter.
DATABASE_URL=postgresql://visibility:visibility@localhost:5432/visibility
