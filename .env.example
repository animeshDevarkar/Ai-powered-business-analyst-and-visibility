# Copy to apps/api/.env. Login pages work before credentials are configured.
PORT=4000
HOST=127.0.0.1
# User workspaces remain in JSON files, separate from MongoDB authentication.
WORKSPACE_DATA_DIR=../../.data/workspaces
# MongoDB authentication database. Add your connection URL here later.
MONGODB_URI=
MONGODB_DB=analytiq
# Atlas / replica sets support transactions. Set false for standalone MongoDB.
MONGODB_TRANSACTIONS=true
# Generate a random secret of at least 32 characters. Keep it server-side.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth credentials (Web application). Callback URI:
# http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Reserved for the future Postgres repository. Not used by the JSON adapter.
DATABASE_URL=postgresql://visibility:visibility@localhost:5432/visibility
# Content Studio: server-side AI credentials and a Responses-compatible model.
OPENAI_API_KEY=
CONTENT_AI_MODEL=
# Select a currently supported Meta Graph API version, e.g. vXX.0.
META_GRAPH_API_VERSION=
# JSON array of project-scoped social accounts. Never use NEXT_PUBLIC_ variables.
# accountId: Instagram professional account ID, Facebook Page ID, or LinkedIn person URN.
# [{"projectId":"PROJECT_UUID","platform":"linkedin","accountId":"urn:li:person:MEMBER_ID","accessToken":"TOKEN","label":"Your LinkedIn profile"}]
CONTENT_SOCIAL_ACCOUNTS=[]
